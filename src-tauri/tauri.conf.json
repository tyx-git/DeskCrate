{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskCrate",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../react/dist",
    "devUrl": "http://localhost:5173/",
    "beforeDevCommand": "npm run dev --prefix react",
    "beforeBuildCommand": "npm run build --prefix react"
  },
  "app": {
    "windows": [
      {
        "title": "DeskCrate",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://localhost:5173 ws://localhost:5173; img-src 'self' asset: http://asset.localhost https://asset.localhost data:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$EXE/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
